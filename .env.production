# Production build-time values for apps/web. Vite bakes every VITE_*
# variable into the static bundle at build time (see apps/web/vite.config.ts,
# which points envDir at the repo root so this file is picked up
# automatically by `npm run build --workspace=apps/web` — Vite loads
# .env.production on top of .env whenever the mode is "production", which
# `vite build` always is unless overridden).
#
# Committed on purpose: nothing here is a secret — VITE_* values ship
# inside the public JS bundle regardless of where they come from.
#
# The API runs on its own subdomain (api.allinonsr.com), not a same-origin
# /api path on the main domain — see the cPanel "Setup Node.js App"
# Application URL and bin/deploy-cpanel.sh's notes. Forgetting this file
# (or leaving it stale after the API's domain changes) silently ships a
# frontend that calls the wrong origin — see apps/web/src/api/client.ts.
VITE_API_BASE_URL=https://api.allinonsr.com/api

# Same Google OAuth client ID as the server's GOOGLE_CLIENT_ID (see
# .env.example) — safe to ship client-side, it's not a secret.
VITE_GOOGLE_CLIENT_ID=520224367396-r41748j0v2k7cl2arcqok6hc2ba70ss8.apps.googleusercontent.com
