# dependencies
node_modules/
apps/*/node_modules/
packages/*/node_modules/

# secrets — never commit
.env
.env.*
!.env.example
# Exception: no secrets in here, just the production VITE_* values Vite
# bakes into apps/web/dist at build time — see apps/web/vite.config.ts's
# envDir and the note at the top of .env.production.
!.env.production

# deployment backups — large binaries, never commit
*.zip
old_cpanel_backup*

# build output
# The cPanel host can't run tsc/vite/prisma at all (WebAssembly OOMs under
# its 4GB ulimit -v), so apps/web/dist, apps/api/dist, and
# packages/shared/dist are built locally and committed on purpose — see
# bin/deploy-cpanel.sh and the note at the bottom of apps/api/prisma/schema.prisma.
# Everything else under dist/build stays ignored as before.
dist/
build/
apps/*/dist/
apps/*/build/
packages/*/dist/
!apps/web/dist/
!apps/api/dist/
!packages/shared/dist/

# prisma
apps/api/prisma/*.db
apps/api/prisma/migrations/dev/

# logs
*.log
npm-debug.log*
logs/

# test/coverage
coverage/

# editor/os
.DS_Store
.vscode/
*.swp

# misc
.turbo/
.cache/
