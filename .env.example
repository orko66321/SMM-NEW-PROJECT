# Copy this file to .env and fill in real values. Never commit .env.

# ── Postgres (used by docker-compose.yml and by apps/api DATABASE_URL) ──────
POSTGRES_USER=smm_panel
POSTGRES_PASSWORD=change_me_to_a_long_random_value
POSTGRES_DB=smm_panel
POSTGRES_PORT=5432

# apps/api reads this directly (must match the values above when using docker-compose)
DATABASE_URL=postgresql://smm_panel:change_me_to_a_long_random_value@localhost:5432/smm_panel?schema=public

# ── API server ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of allowed browser origins for CORS
CORS_ORIGIN=http://localhost:5173

# Cookie domain for the refresh-token cookie (leave blank for localhost)
COOKIE_DOMAIN=

# Encrypts provider API keys / payment gateway credentials at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace_with_a_base64_32_byte_key

# Must be a URL the browser/payment gateway can actually reach once a gateway
# is enabled (not localhost) — used to build callback/redirect URLs.
APP_BASE_URL=http://localhost:4000

# Where a payment gateway callback redirects the browser back to (the web app).
FRONTEND_BASE_URL=http://localhost:5173

# Payment gateway credentials (bKash, etc.) are NOT stored here — they're
# entered through the admin panel's Payment Gateways page and stored
# encrypted in Postgres via ENCRYPTION_KEY above (see PaymentGatewayConfig).
# This keeps adding/rotating a gateway an admin-UI action, not a redeploy.

# ── Frontend (apps/web) ─────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4000/api
